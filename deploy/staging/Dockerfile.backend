# Multi-stage build for EmployaSkills Backend Staging (VPS Jagoan Hosting)
# Target: Node.js 22 Alpine, minimal attack surface, healthcheck enabled

# Stage 1: Build TypeScript to JavaScript bundle
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json

RUN npm ci

COPY backend/src ./backend/src
COPY backend/tsconfig.json ./backend/tsconfig.json

RUN npm run build:backend

# Stage 2: Production runtime
FROM node:22-alpine AS runtime
WORKDIR /app

# Utilities untuk container health checks
RUN apk add --no-cache wget curl

ENV NODE_ENV=production
ENV PORT=5000

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json

RUN npm ci --omit=dev --workspace=backend && npm cache clean --force

COPY --from=build /app/backend/dist ./backend/dist
COPY backend/migrations ./backend/migrations

# Pastikan folder penyimpanan data dan bukti terisolasi
RUN mkdir -p /app/backend/data /app/backend/evidence

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5000/api/health | grep -q '"status":"ok"' || exit 1

CMD ["node", "backend/dist/server.js"]
