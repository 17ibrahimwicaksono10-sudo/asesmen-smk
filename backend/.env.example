# Port server backend (default: 5000)
PORT=5000

# Gemini API (HANYA untuk OCR Bukti Foto dan Transkripsi Audio STT)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek API Key (Opsional: Jika diisi, backend otomatis memprioritaskan DeepSeek AI)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# URL frontend untuk CORS (contoh: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

