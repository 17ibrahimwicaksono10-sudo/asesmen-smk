# Port server backend (default: 5000)
PORT=5000

# Gemini API Key untuk evaluasi esai dan analisis kesiapan kerja AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# DeepSeek API Key (Opsional: Jika diisi, backend otomatis memprioritaskan DeepSeek AI)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# URL frontend untuk CORS (contoh: http://localhost:5173,https://*.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Cloudflare R2 Storage (S3-Compatible Private Bucket untuk Foto Jawaban, Audio, Sertifikat)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=employaskills-evidence
