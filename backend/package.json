{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/safe_rollback_database.ts src/emergency_reset_password.ts src/migrate_passwords.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:passwords": "node dist/migrate_passwords.js",
    "rollback:evidence": "tsx src/rollback.ts",
    "rollback:database": "node dist/safe_rollback_database.js",
    "emergency:reset-password": "node dist/emergency_reset_password.js",
    "dev:rollback:database": "tsx src/safe_rollback_database.ts",
    "dev:emergency:reset-password": "tsx src/emergency_reset_password.ts",
    "verify:api": "node src/verify_live_api_connectivity.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
