# ==============================================================================
# EmployaSkills Environment Variables Template (Production & Staging)
# CATATAN: Jangan isi nilai rahasia di file template ini.
# Salin ke .env atau backend/.env pada server/VPS.
# ==============================================================================

# Port server backend Express (default: 5000)
PORT=5000

# URL frontend untuk CORS (contoh: http://localhost:5173 atau https://employaskills.duckdns.org)
CLIENT_ORIGIN=http://localhost:5173

# ==============================================================================
# DATABASE POSTGRESQL (SUPABASE SESSION POOLER - PORT 5432)
# Diuji dan diverifikasi dari VPS Jagoan Hosting ke Supabase Singapore (ap-southeast-1)
# Mode Session Pooler (Port 5432) mendukung prepared statements dan kompatibel penuh
# ==============================================================================
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL=true

# Parameter individual alternatif jika tidak menggunakan DATABASE_URL tunggal:
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=[YOUR_DB_PASSWORD]

# ==============================================================================
# SUPABASE STORAGE PRIVAT (BUKTI MULTIMODAL)
# ==============================================================================
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=employaskills-evidence-private

# ==============================================================================
# AI PROVIDERS
# ==============================================================================
# 1. Gemini API Key (Pemrosesan Gambar Vision Multimodal dan Transkripsi Audio STT)
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
GEMINI_MODEL=gemini-1.5-flash

# 2. DeepSeek API Key (Penilaian Jawaban Esai Berdasarkan Rubrik Objektif)
DEEPSEEK_API_KEY=[YOUR_DEEPSEEK_API_KEY]
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
