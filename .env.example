# ==============================================================================
# EmployaSkills Environment Variables Template (Production & Development)
# CATATAN: Jangan isi nilai API key rahasia di file template ini.
# Salin ke backend/.env pada server/VPS.
# ==============================================================================

# Port server backend (default: 5000)
PORT=5000

# URL frontend untuk CORS (contoh: http://localhost:5173 atau https://employaskills.duckdns.org)
CLIENT_ORIGIN=http://localhost:5173

# 1. Gemini API (HANYA digunakan untuk Membaca Gambar/OCR dan Transkripsi Audio STT)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. DeepSeek API Key (Digunakan untuk Penilaian Jawaban Esai Berdasarkan Rubrik)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
